rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'uzorbenny51@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Helpers ---
    function isValidProduct(data) {
      return data.keys().hasAll([
        'sku', 'name', 'category', 'division', 'description',
        'specifications', 'priceUsd', 'unit', 'stockStatus',
        'bookable', 'imageUrl', 'featured', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sku', 'name', 'category', 'division', 'description',
        'specifications', 'priceUsd', 'unit', 'stockStatus',
        'bookable', 'imageUrl', 'featured', 'createdAt', 'updatedAt'
      ]) &&
      data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40 &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
      data.category in [
        'Glass Doors & Windows',
        'Aluminium Systems',
        'Security Glass',
        'Architectural Ceilings',
        'Heavy Machinery',
        'Swimming Pool Systems'
      ] &&
      data.division is string && data.division.size() >= 2 && data.division.size() <= 80 &&
      data.description is string && data.description.size() >= 10 && data.description.size() <= 1500 &&
      data.specifications is list && data.specifications.size() <= 10 &&
      (data.specifications.size() == 0 || (data.specifications[0] is string && data.specifications[0].size() <= 160)) &&
      data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 10000000 &&
      data.unit is string && data.unit.size() >= 2 && data.unit.size() <= 40 &&
      data.stockStatus in ['In Stock', 'Made to Order', 'Pre-Order'] &&
      data.bookable is bool &&
      data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000 &&
      data.featured is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'userId', 'invoiceNumber', 'orderType', 'customerName', 'companyName',
        'customerEmail', 'customerPhone', 'shippingAddress', 'destinationRegion',
        'bookingDate', 'notes', 'subtotalUsd', 'taxUsd', 'totalUsd',
        'itemCount', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'invoiceNumber', 'orderType', 'customerName', 'companyName',
        'customerEmail', 'customerPhone', 'shippingAddress', 'destinationRegion',
        'bookingDate', 'notes', 'subtotalUsd', 'taxUsd', 'totalUsd',
        'itemCount', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.invoiceNumber is string && data.invoiceNumber.size() >= 5 && data.invoiceNumber.size() <= 40 &&
      data.invoiceNumber.matches('^PSG-[0-9]{4}-[0-9]{4,8}$') &&
      data.orderType in ['order', 'booking'] &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
      data.companyName is string && data.companyName.size() <= 140 &&
      data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160 &&
      data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 40 &&
      data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300 &&
      data.destinationRegion in ['Japan', 'Europe', 'Asia', 'Taiwan', 'International'] &&
      data.bookingDate is string && data.bookingDate.size() <= 40 &&
      data.notes is string && data.notes.size() <= 600 &&
      data.subtotalUsd is number && data.subtotalUsd >= 0 && data.subtotalUsd <= 100000000 &&
      data.taxUsd is number && data.taxUsd >= 0 && data.taxUsd <= 50000000 &&
      data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 150000000 &&
      data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 10000 &&
      data.status in ['Confirmed', 'In Fabrication', 'Dispatched', 'Completed', 'Cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidOrderItem(data, orderId) {
      return data.keys().hasAll([
        'orderId', 'userId', 'productId', 'sku', 'productName',
        'category', 'unit', 'quantity', 'unitPriceUsd', 'lineTotalUsd'
      ]) &&
      data.keys().hasOnly([
        'orderId', 'userId', 'productId', 'sku', 'productName',
        'category', 'unit', 'quantity', 'unitPriceUsd', 'lineTotalUsd'
      ]) &&
      data.orderId == orderId &&
      isValidId(data.orderId) &&
      isValidId(data.userId) &&
      isValidId(data.productId) &&
      data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40 &&
      data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 140 &&
      data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
      data.unit is string && data.unit.size() >= 2 && data.unit.size() <= 40 &&
      data.quantity is number && data.quantity >= 1 && data.quantity <= 5000 &&
      data.unitPriceUsd is number && data.unitPriceUsd >= 0 && data.unitPriceUsd <= 10000000 &&
      data.lineTotalUsd is number && data.lineTotalUsd >= 0 && data.lineTotalUsd <= 100000000;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
        'userId', 'name', 'company', 'email', 'phone',
        'market', 'division', 'message', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'name', 'company', 'email', 'phone',
        'market', 'division', 'message', 'status', 'createdAt'
      ]) &&
      isValidId(data.userId) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
      data.company is string && data.company.size() <= 140 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40 &&
      data.market in ['Japan', 'Europe', 'Asia', 'Taiwan', 'Other'] &&
      data.division is string && data.division.size() >= 2 && data.division.size() <= 80 &&
      data.message is string && data.message.size() >= 10 && data.message.size() <= 2000 &&
      data.status in ['New', 'Reviewed', 'Quoted', 'Closed'] &&
      data.createdAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'displayName', 'email', 'companyName', 'phone', 'shippingAddress', 'updatedAt']) &&
      data.uid == userId &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 140)) &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
      (!('shippingAddress' in data) || (data.shippingAddress is string && data.shippingAddress.size() <= 300)) &&
      data.updatedAt is timestamp;
    }

    function isValidAdminMember(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
      data.uid == userId &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.role == 'admin' &&
      data.createdAt is timestamp;
    }

    function isValidAdminSecurity(data) {
      return data.keys().hasAll(['algorithm', 'iterations', 'saltHex', 'hashHex', 'updatedBy', 'updatedAt']) &&
      data.keys().hasOnly(['algorithm', 'iterations', 'saltHex', 'hashHex', 'updatedBy', 'updatedAt']) &&
      data.algorithm == 'PBKDF2-SHA256' &&
      data.iterations is number && data.iterations >= 100000 && data.iterations <= 500000 &&
      data.saltHex is string && data.saltHex.size() >= 32 && data.saltHex.size() <= 64 &&
      data.hashHex is string && data.hashHex.size() >= 64 && data.hashHex.size() <= 128 &&
      data.updatedBy == request.auth.uid &&
      isValidId(data.updatedBy) &&
      data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isEmailVerified() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'Confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().invoiceNumber == existing().invoiceNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bookingDate', 'notes', 'updatedAt'])) || (
            isEmailVerified() &&
            existing().userId == request.auth.uid &&
            existing().status == 'Confirmed' &&
            incoming().status == 'Cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /items/{itemId} {
        allow get: if isSignedIn() && isValidId(orderId) && isValidId(itemId) && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin()
        );
        allow list: if isSignedIn() && (
          existing().userId == request.auth.uid || isAdmin()
        );
        allow create: if isEmailVerified() &&
          isValidId(orderId) &&
          isValidId(itemId) &&
          isValidOrderItem(incoming(), orderId) &&
          incoming().userId == request.auth.uid &&
          (
            existsAfter(/databases/$(database)/documents/orders/$(orderId)) &&
            getAfter(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow create: if isEmailVerified() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'New' &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminMember(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update, delete: if isAdmin() && isValidId(userId);
    }

    match /adminSecurity/{docId} {
      allow get: if isAdmin() && isValidId(docId);
      allow list: if false;
      allow create, update: if isAdmin() &&
        docId == 'master' &&
        isValidAdminSecurity(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
